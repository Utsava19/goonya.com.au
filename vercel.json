{
  "functions": {
    "api/growth-audit.js": {
      "maxDuration": 30
    },
    "api/contact.js": {
      "maxDuration": 15
    }
  },
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "https://www.goonya.com.au/:path+",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "goonya.com.au"
        }
      ],
      "destination": "https://www.goonya.com.au/",
      "permanent": true
    },
    {
      "source": "/:path+",
      "has": [
        {
          "type": "host",
          "value": "goonya.com.au"
        }
      ],
      "destination": "https://www.goonya.com.au/:path+",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Link",
          "value": "<https://www.goonya.com.au/sitemap.xml>; rel=\"sitemap\""
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|sitemap\\.xml|robots\\.txt|assets/|brand/|email/|google-business/).*)",
      "destination": "/"
    }
  ]
}
