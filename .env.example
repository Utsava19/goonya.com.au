# Add to Vercel → Project → Settings → Environment Variables, then redeploy.
# Create GA4 at https://analytics.google.com → Admin → Data streams → Web → Measurement ID (G-XXXXXXXXXX)

VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional — use GTM instead of GA4 direct (only one is needed)
# VITE_GTM_ID=GTM-XXXXXXX

# Contact form — branded thank-you email + enquiry notifications (server-side only)
# Create at https://resend.com → API Keys, then verify goonya.com.au domain
# Until the domain shows "Verified" in Resend, the form falls back to FormSubmit.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional override (default: Goonya <hello@goonya.com.au> — requires verified domain)
# RESEND_FROM=Goonya <hello@goonya.com.au>
