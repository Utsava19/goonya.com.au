# Add to Vercel → Project → Settings → Environment Variables, then redeploy.
# Create GA4 at https://analytics.google.com → Admin → Data streams → Web → Measurement ID (G-XXXXXXXXXX)

VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

